# ══════════════════════════════════════════════════════════════════════════
# Dockerfile.render — Quant-LEAN Engineering Dashboard for Render.com
# ══════════════════════════════════════════════════════════════════════════
# Uses QuantConnect's official foundation image (includes .NET SDK + Python)
# ══════════════════════════════════════════════════════════════════════════

FROM quantconnect/lean:foundation

WORKDIR /app

# 1. Install Python dependencies for the Flask server first (cached layer)
RUN pip install --no-cache-dir flask flask-cors yfinance pandas gunicorn

# 2. Copy C# projects & data needed for compilation
COPY Launcher/ /app/Launcher/
COPY Data/ /app/Data/
COPY Common/ /app/Common/
COPY Engine/ /app/Engine/
COPY Algorithm/ /app/Algorithm/
COPY Algorithm.Framework/ /app/Algorithm.Framework/
COPY AlgorithmFactory/ /app/AlgorithmFactory/
COPY Api/ /app/Api/
COPY Brokerages/ /app/Brokerages/
COPY Compression/ /app/Compression/
COPY Configuration/ /app/Configuration/
COPY DownloaderDataProvider/ /app/DownloaderDataProvider/
COPY Indicators/ /app/Indicators/
COPY Logging/ /app/Logging/
COPY Messaging/ /app/Messaging/
COPY Queues/ /app/Queues/
COPY Research/ /app/Research/
COPY QuantConnect.Lean.sln LICENSE /app/
COPY LocalPackages/ /app/LocalPackages/

# 2b. Create a stub Algorithm.CSharp project to suppress MSB9008 warning
#     Engine.csproj references ../Algorithm.CSharp/QuantConnect.Algorithm.CSharp.csproj
#     If it does not exist, MSBuild emits warning MSB9008 and may route the
#     algorithm through the C# IL loader instead of the Python loader (LL-15).
RUN mkdir -p /app/Algorithm.CSharp && \
    printf '<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>net10.0</TargetFramework><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath><AssemblyName>QuantConnect.Algorithm.CSharp</AssemblyName></PropertyGroup><ItemGroup><ProjectReference Include="../Algorithm.Framework/QuantConnect.Algorithm.Framework.csproj" /></ItemGroup></Project>' \
    > /app/Algorithm.CSharp/QuantConnect.Algorithm.CSharp.csproj

# 3. Restore, build the LEAN Launcher project (with Workstation GC & analyzers disabled),
#    and clean intermediate build caches in a SINGLE layer.
RUN dotnet restore Launcher/QuantConnect.Lean.Launcher.csproj && \
    dotnet build Launcher/QuantConnect.Lean.Launcher.csproj -c Debug --no-restore \
        -p:DebugType=none -p:DebugSymbols=false \
        -p:ServerGarbageCollection=false \
        -p:RunAnalyzers=false -p:RunAnalyzersDuringBuild=false -p:AnalysisMode=None -v q -nologo && \
    cp -f /app/Common/AlgorithmImports.py /app/Launcher/bin/Debug/AlgorithmImports.py && \
    dotnet nuget locals all --clear && \
    rm -rf /root/.nuget /tmp/* /app/*/obj && \
    find /app -mindepth 2 -maxdepth 2 -type d -name "bin" ! -path "/app/Launcher/bin" -exec rm -rf {} + && \
    find /app/Launcher/bin -name "*.pdb" -delete && \
    rm -rf /app/Data/option /app/Data/future /app/Data/forex /app/Data/cfd /app/Data/futureoption /app/Data/equity/usa/tick /app/Data/equity/usa/second /app/Data/equity/usa/fundamental

# 3b. Verify the pre-built DLLs and AlgorithmImports.py exist (fails the image build early if missing)
RUN echo "=== LEAN Launcher Build Artifacts ===" && \
    ls -lh /app/Launcher/bin/Debug/QuantConnect.*.dll /app/Launcher/bin/Debug/AlgorithmImports.py && \
    test -f /app/Launcher/bin/Debug/QuantConnect.Lean.Launcher.dll && \
    test -f /app/Launcher/bin/Debug/QuantConnect.Research.dll && \
    test -f /app/Launcher/bin/Debug/QuantConnect.Algorithm.Framework.dll || \
    (echo "ERROR: Required LEAN DLLs not found after build!" && exit 1)

# 4. Pre-warm ticker cache (LL-16)
#    Docker build uses ephemeral builder IPs (not the persistent Render service
#    IP), so Yahoo Finance rate-limiting is far less likely during image build.
#    Baking ZIPs into the image means the first backtest needs no network call.
#    Failures for individual tickers are non-fatal (logged as WARN).
RUN python3 - <<'PYEOF'
import yfinance as yf, zipfile, pathlib, sys

tickers = ['GOOG', 'AAPL', 'AOT.BK', 'PTT.BK', 'SCB.BK', 'KBANK.BK']
data_dir = pathlib.Path('/app/Data/equity/usa/daily')
data_dir.mkdir(parents=True, exist_ok=True)

for ticker in tickers:
    try:
        import pandas as pd
        df = yf.download(ticker, start='1998-01-01', progress=False, auto_adjust=True)
        if df is None or df.empty:
            print(f'WARN: no data for {ticker}', file=sys.stderr)
            continue
        if isinstance(df.columns, pd.MultiIndex):
            df.columns = df.columns.get_level_values(0)
        lines = []
        for idx, row in df.iterrows():
            d = idx.strftime('%Y%m%d 00:00')
            o = int(round(float(row['Open'])  * 10000))
            h = int(round(float(row['High'])  * 10000))
            l = int(round(float(row['Low'])   * 10000))
            c = int(round(float(row['Close']) * 10000))
            v = max(0, int(round(float(row['Volume']))))
            lines.append(f'{d},{o},{h},{l},{c},{v}')
        zip_path = data_dir / f'{ticker.lower()}.zip'
        with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zf:
            zf.writestr(f'{ticker.lower()}.csv', '\n'.join(lines) + '\n')
        print(f'OK: {ticker} ({len(lines)} bars up to {lines[-1][:8] if lines else "?"})', flush=True)
    except Exception as e:
        print(f'WARN: {ticker} failed: {e}', file=sys.stderr)
PYEOF

# 5. Copy Python strategies and Web UI LAST so edits to Python/UI skip C# compilation
COPY Algorithm.Python/ /app/Algorithm.Python/
COPY backtest_ui/ /app/backtest_ui/

# 6. Runtime environment: Workstation GC + heap cap for 512MB Render containers
ENV PORT=5000 \
    DOTNET_gcServer=0 \
    DOTNET_GCHeapHardLimit=0x16000000 \
    DOTNET_GCHighMemPercent=75 \
    LEAN_SKIP_MATPLOTLIB=1 \
    LEAN_SKIP_RESEARCH=1
EXPOSE 5000

# 7. Launch the Flask server via Gunicorn (1 worker for shared _state & low RAM, 8 threads, 300s timeout)
WORKDIR /app
CMD ["sh", "-c", "gunicorn --workers 1 --threads 8 --timeout 300 --graceful-timeout 30 --bind 0.0.0.0:${PORT:-5000} backtest_ui.server:app"]

